<Window x:Class="CameraInspector.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CameraInspector"
        Title="{DynamicResource Settings}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" Icon="CameraInspector.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=LanguagePicker}">
    <Grid Width="360" Background="{DynamicResource Background}">
        <StackPanel Margin="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label x:Name="LanguageLabel" Content="{DynamicResource LanguageLabel}" Target="{Binding ElementName=LanguagePicker}"
                       Foreground="{DynamicResource Secondary}" Padding="0,0,12,0" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguagePicker" Grid.Column="1" Style="{StaticResource Dropdown}" MaxDropDownHeight="360"
                          AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="ChoiceName" Text="{Binding Name}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Code}" Value="system">
                                    <Setter TargetName="ChoiceName" Property="Text" Value="{DynamicResource SystemOption}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label x:Name="ThemeLabel" Grid.Row="1" Content="{DynamicResource ThemeLabel}" Target="{Binding ElementName=ThemePicker}"
                       Foreground="{DynamicResource Secondary}" Margin="0,10,0,0" Padding="0,0,12,0" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemePicker" Grid.Row="1" Grid.Column="1" Style="{StaticResource Dropdown}" Margin="0,10,0,0"
                          AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="ChoiceName" Text="{DynamicResource SystemOption}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static local:AppTheme.Light}">
                                    <Setter TargetName="ChoiceName" Property="Text" Value="{DynamicResource ThemeLight}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Static local:AppTheme.Dark}">
                                    <Setter TargetName="ChoiceName" Property="Text" Value="{DynamicResource ThemeDark}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Border BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Margin="0,20,0,16" />
            <TextBlock x:Name="AboutHeading" Text="{DynamicResource About}" Foreground="{DynamicResource Secondary}" Margin="0,0,0,4" />
            <TextBlock Text="Camera Inspector" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="AboutDescription" Text="{DynamicResource CameraDiagnostics}" Foreground="{DynamicResource Secondary}" FontSize="13" />
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Secondary}" Margin="0,4,0,18" />
            <TextBlock>
                <Hyperlink x:Name="SupportedCamerasLink" Foreground="{DynamicResource Accent}"
                           NavigateUri="https://github.com/notuxius/camera-inspector#brand-support-backlog" RequestNavigate="OnOpenLink">
                    <Run Text="{DynamicResource SupportedCameras}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0">
                <Hyperlink x:Name="CheckForUpdatesLink" Foreground="{DynamicResource Accent}"
                           NavigateUri="https://github.com/notuxius/camera-inspector/releases/latest" RequestNavigate="OnOpenLink">
                    <Run Text="{DynamicResource CheckForUpdates}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="BrowserError" Foreground="{DynamicResource Yellow}" Margin="0,12,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="CloseButton" Content="{DynamicResource Close}" IsCancel="True"
                    HorizontalAlignment="Right" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>
