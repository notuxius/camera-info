<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.6.0</Version>
    <AssemblyTitle>Camera Inspector</AssemblyTitle>
    <Product>Camera Inspector</Product>
    <ApplicationIcon>CameraInspector.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="CameraInspector.Checks" />
    <Resource Include="CameraInspector.ico" />
    <EmbeddedResource Include="Locales/*.json" LogicalName="CameraInspector.Locales.%(Filename).json" />
  </ItemGroup>
</Project>
