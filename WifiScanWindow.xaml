<Window x:Class="CameraInspector.WifiScanWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ScanWifi}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" Icon="CameraInspector.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Loaded="OnLoaded"
        FocusManager.FocusedElement="{Binding ElementName=AddressBox}">
    <Border Background="{DynamicResource Background}" Padding="24">
        <StackPanel Width="446">
            <TextBlock Text="{DynamicResource WifiSetup}" TextWrapping="Wrap" />
            <StackPanel x:Name="DiscoveredPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <Label Content="{DynamicResource WifiFound}" Target="{Binding ElementName=DiscoveredPicker}"
                       Foreground="{DynamicResource Secondary}" Padding="0,0,0,4" />
                <ComboBox x:Name="DiscoveredPicker" Style="{StaticResource Dropdown}" FlowDirection="LeftToRight"
                          MaxDropDownHeight="240" SelectionChanged="OnDiscoveredChanged" />
            </StackPanel>
            <Label Content="{DynamicResource WifiAddress}" Target="{Binding ElementName=AddressBox}"
                   Foreground="{DynamicResource Secondary}" Margin="0,14,0,0" Padding="0,0,0,4" />
            <TextBox x:Name="AddressBox" FlowDirection="LeftToRight" Padding="8,5" MaxLength="45"
                     Background="{DynamicResource InputFill}" Foreground="{DynamicResource Text}"
                     BorderBrush="{DynamicResource ControlEdge}" CaretBrush="{DynamicResource Text}"
                     AutomationProperties.Name="{DynamicResource WifiAddress}" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Visibility="Collapsed"
                       Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button x:Name="FindButton" DockPanel.Dock="Left" Content="{DynamicResource WifiFind}" Click="OnFind" />
                <Button DockPanel.Dock="Right" Content="{DynamicResource Close}" IsCancel="True" />
                <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="{DynamicResource WifiConnect}"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConnect" Margin="0,0,8,0" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
