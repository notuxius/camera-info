<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.1</Version>
    <Product>Camera Info</Product>
    <ApplicationIcon>CameraInfo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="CameraInfo.Checks" />
    <Resource Include="CameraInfo.ico" />
    <EmbeddedResource Include="Locales/*.json" LogicalName="CameraInfo.Locales.%(Filename).json" />
  </ItemGroup>
</Project>
