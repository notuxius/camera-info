<Window x:Class="CameraInspector.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" Icon="CameraInspector.ico"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=LanguagePicker}">
    <Grid Width="360" Background="{StaticResource Background}">
        <StackPanel Margin="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label x:Name="LanguageLabel" Content="{DynamicResource LanguageLabel}" Target="{Binding ElementName=LanguagePicker}"
                       Foreground="{StaticResource Secondary}" Padding="0,0,12,0" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguagePicker" Grid.Column="1" Style="{StaticResource Dropdown}" MaxDropDownHeight="360"
                          AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" />
            </Grid>
            <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,20,0,16" />
            <TextBlock x:Name="AboutHeading" Text="{DynamicResource About}" Foreground="{StaticResource Secondary}" Margin="0,0,0,4" />
            <TextBlock Text="Camera Inspector" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Foreground="{StaticResource Secondary}" Margin="0,4,0,18" />
            <TextBlock>
                <Hyperlink x:Name="SupportedCamerasLink" Foreground="{StaticResource Accent}"
                           NavigateUri="https://github.com/notuxius/camera-inspector#brand-support-backlog" RequestNavigate="OnOpenLink">
                    <Run Text="{DynamicResource SupportedCameras}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0">
                <Hyperlink x:Name="CheckForUpdatesLink" Foreground="{StaticResource Accent}"
                           NavigateUri="https://github.com/notuxius/camera-inspector/releases/latest" RequestNavigate="OnOpenLink">
                    <Run Text="{DynamicResource CheckForUpdates}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="BrowserError" Foreground="{StaticResource Yellow}" Margin="0,12,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="CloseButton" Content="{DynamicResource Close}" IsCancel="True"
                    HorizontalAlignment="Right" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>
