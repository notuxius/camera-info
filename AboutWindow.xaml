<Window x:Class="CameraInspector.AboutWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" Icon="CameraInspector.ico"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Width="344" Background="{StaticResource Background}">
        <StackPanel Margin="24">
            <TextBlock Text="Camera Inspector" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Foreground="{StaticResource Secondary}" Margin="0,4,0,18" />
            <TextBlock>
                <Hyperlink x:Name="SupportedCamerasLink" Foreground="{StaticResource Accent}"
                           NavigateUri="https://github.com/notuxius/camera-inspector#brand-support-backlog" RequestNavigate="OnOpenLink">
                    <Run Text="{DynamicResource SupportedCameras}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0">
                <Hyperlink x:Name="CheckForUpdatesLink" Foreground="{StaticResource Accent}"
                           NavigateUri="https://github.com/notuxius/camera-inspector/releases/latest" RequestNavigate="OnOpenLink">
                    <Run Text="{DynamicResource CheckForUpdates}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="BrowserError" Foreground="{StaticResource Yellow}" Margin="0,12,0,0"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="CloseButton" Content="{DynamicResource Close}" IsCancel="True"
                    HorizontalAlignment="Right" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>
